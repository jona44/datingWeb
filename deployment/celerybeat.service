[Unit]
Description=Celery Beat Scheduler
After=network.target redis.service

[Service]
User=deploy
Group=deploy
WorkingDirectory=/var/www/dating
EnvironmentFile=/var/www/dating/.env
ExecStart=/var/www/dating/env/bin/celery \
    -A core beat \
    --loglevel=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
